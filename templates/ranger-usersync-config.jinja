# Ranger Usersync install.properties, read by setup.py. The charm syncs from LDAP.

ranger_base_dir = /usr/lib/ranger/usersync

# Base URL of the Ranger Admin policy manager.
POLICY_MGR_URL = {{ POLICY_MGR_URL }}
SYNC_SOURCE = ldap
# Seconds between synchronisations.
SYNC_INTERVAL = {{ SYNC_INTERVAL }}

# OS user and group that own the usersync files: the rock's existing service user.
unix_user=_daemon_
unix_group=_daemon_

# Password of the rangerusersync user in Ranger Admin.
rangerUsersync_password= {{ RANGER_USERSYNC_PWD }}

hadoop_conf=/etc/hadoop/conf

# Credential store for the passwords above.
CRED_KEYSTORE_FILENAME=/usr/lib/ranger/usersync/conf/rangerusersync.jceks

# Role assignment for synced users and groups. The delimiters must differ from
# each other and from characters allowed in user and group names. Rules have the
# form ROLE_SYS_ADMIN:u:user1,user2&ROLE_USER:g:group1; empty assigns no roles.
ROLE_ASSIGNMENT_LIST_DELIMITER = &
USERS_GROUPS_ASSIGNMENT_LIST_DELIMITER = :
USERNAME_GROUPNAME_ASSIGNMENT_LIST_DELIMITER = ,
GROUP_BASED_ROLE_ASSIGNMENT_RULES =

# LDAP server URL, for example ldap://ldap.example.com:389.
SYNC_LDAP_URL = {{ SYNC_LDAP_URL }}

# DN and password used to bind to LDAP.
SYNC_LDAP_BIND_DN = {{ SYNC_LDAP_BIND_DN }}
SYNC_LDAP_BIND_PASSWORD = {{ SYNC_LDAP_BIND_PASSWORD }}

# Sync only entries changed since the previous run.
SYNC_LDAP_DELTASYNC = {{ SYNC_LDAP_DELTASYNC }}

# Search base for users and groups.
SYNC_LDAP_SEARCH_BASE = {{ SYNC_LDAP_SEARCH_BASE }}

# Search base for users; overrides SYNC_LDAP_SEARCH_BASE.
SYNC_LDAP_USER_SEARCH_BASE = {{ SYNC_LDAP_USER_SEARCH_BASE }}

# User search scope: base, one or sub.
SYNC_LDAP_USER_SEARCH_SCOPE = {{ SYNC_LDAP_USER_SEARCH_SCOPE }}

# Object class that identifies user entries.
SYNC_LDAP_USER_OBJECT_CLASS = {{ SYNC_LDAP_USER_OBJECT_CLASS }}

# Optional additional filter for users, for example (dept=eng).
SYNC_LDAP_USER_SEARCH_FILTER = {{ SYNC_LDAP_USER_SEARCH_FILTER }}

# User entry attribute used as the user name.
SYNC_LDAP_USER_NAME_ATTRIBUTE = {{ SYNC_LDAP_USER_NAME_ATTRIBUTE }}

# Comma-separated user entry attributes whose values are the user's groups.
SYNC_LDAP_USER_GROUP_NAME_ATTRIBUTE = {{ SYNC_LDAP_USER_GROUP_NAME_ATTRIBUTE }}

# Case conversion for synced user and group names: none, lower or upper.
SYNC_LDAP_USERNAME_CASE_CONVERSION = {{ SYNC_LDAP_USERNAME_CASE_CONVERSION }}
SYNC_LDAP_GROUPNAME_CASE_CONVERSION = {{ SYNC_LDAP_GROUPNAME_CASE_CONVERSION }}

logdir=/var/log/ranger/usersync
USERSYNC_PID_DIR_PATH=/var/run/ranger

# Find groups with an LDAP group search instead of user entry attributes.
# Any value other than true is treated as false.
SYNC_GROUP_SEARCH_ENABLED= {{ SYNC_GROUP_SEARCH_ENABLED }}

# Also sync the memberships of the groups found by the group search.
# Any value other than true is treated as false.
SYNC_GROUP_USER_MAP_SYNC_ENABLED={{ SYNC_GROUP_USER_MAP_SYNC_ENABLED }}

# Search base for groups; falls back to SYNC_LDAP_SEARCH_BASE, then to
# SYNC_LDAP_USER_SEARCH_BASE.
SYNC_GROUP_SEARCH_BASE = {{ SYNC_GROUP_SEARCH_BASE }}

# Group search scope: base, one or sub.
SYNC_GROUP_SEARCH_SCOPE= {{ SYNC_GROUP_SEARCH_SCOPE }}

# Object class that identifies group entries.
SYNC_GROUP_OBJECT_CLASS= {{ SYNC_GROUP_OBJECT_CLASS }}

# Optional additional filter for groups, for example (dept=eng).
SYNC_LDAP_GROUP_SEARCH_FILTER = {{ SYNC_LDAP_GROUP_SEARCH_FILTER }}

# Group entry attribute used as the group name.
SYNC_GROUP_NAME_ATTRIBUTE= {{ SYNC_GROUP_NAME_ATTRIBUTE }}

# Group entry attribute that lists the members.
SYNC_GROUP_MEMBER_ATTRIBUTE_NAME= {{ SYNC_GROUP_MEMBER_ATTRIBUTE_NAME }}

# Request LDAP results in pages of SYNC_PAGED_RESULTS_SIZE entries. Without
# paging, directories such as Active Directory truncate large result sets.
SYNC_PAGED_RESULTS_ENABLED = {{ SYNC_PAGED_RESULTS_ENABLED }}
SYNC_PAGED_RESULTS_SIZE = {{ SYNC_PAGED_RESULTS_SIZE }}

# LDAP referral handling: ignore or follow.
SYNC_LDAP_REFERRAL = {{ SYNC_LDAP_REFERRAL }}
