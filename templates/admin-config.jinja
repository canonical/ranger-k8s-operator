# Ranger Admin install.properties, read by setup.sh and db_setup.py.
# Every key must stay present: setup.sh substitutes an error message for a
# missing key instead of failing, which corrupts the generated configuration.

PYTHON_COMMAND_INVOKER=python3

# Database flavor and JDBC driver; the charm supports PostgreSQL only.
DB_FLAVOR=postgres
SQL_CONNECTOR_JAR=/usr/share/java/postgresql.jar

# Database connection from the PostgreSQL relation. The relation user owns the
# Ranger schema, so it is both the DB admin and the schema user.
db_root_user={{ DB_USER }}
db_root_password={{ DB_PWD }}
db_host={{ DB_HOST }}:{{ DB_PORT }}
# Database TLS. db_ssl_auth_type is 1-way (server authentication) or 2-way (mutual).
db_ssl_enabled=false
db_ssl_required=false
db_ssl_verifyServerCertificate=false
db_ssl_auth_type=2-way
javax_net_ssl_keyStore=
javax_net_ssl_keyStorePassword=
javax_net_ssl_trustStore=
javax_net_ssl_trustStorePassword=
db_name={{ DB_NAME }}
db_user={{ DB_USER }}
db_password={{ DB_PWD }}

# Passwords of the Ranger internal users, managed by the charm. Ranger applies
# each password only once; later changes go through the Ranger API.
rangerAdmin_password={{ RANGER_ADMIN_PWD }}
rangerTagsync_password={{ RANGER_TAGSYNC_PWD }}
rangerUsersync_password={{ RANGER_USERSYNC_PWD }}
keyadmin_password={{ RANGER_KEYADMIN_PWD }}

# Audit store: solr or elasticsearch. The charm writes audits to OpenSearch
# through the Elasticsearch client, configured from the OpenSearch relation.
audit_store=elasticsearch
audit_elasticsearch_urls={{ OPENSEARCH_HOST }}
audit_elasticsearch_port={{ OPENSEARCH_PORT | default(9200) }}
audit_elasticsearch_protocol=https
audit_elasticsearch_user={{ OPENSEARCH_USER }}
audit_elasticsearch_password={{ OPENSEARCH_PWD }}
audit_elasticsearch_index={{ OPENSEARCH_INDEX | default(ranger_audits) }}
audit_elasticsearch_bootstrap_enabled={{ OPENSEARCH_ENABLED | default( False )}}

# Solr audit store; unused because audit_store is elasticsearch.
audit_solr_urls=
audit_solr_user=
audit_solr_password=
audit_solr_zookeepers=
audit_solr_collection_name=ranger_audits
audit_solr_config_name=ranger_audits
audit_solr_no_shards=1
audit_solr_no_replica=1
audit_solr_max_shards_per_node=1
audit_solr_acl_user_list_sasl=solr,infra-solr
audit_solr_bootstrap_enabled=true

# Policy manager endpoint. Ranger serves plain HTTP inside the cluster; external
# TLS is terminated by the ingress, so the native HTTPS keystore stays unused.
policymgr_external_url=http://ranger-admin:6080
policymgr_http_enabled=true
policymgr_https_keystore_file=
policymgr_https_keystore_keyalias=rangeradmin
policymgr_https_keystore_password=

# Comma-separated service types to support; empty supports all components.
policymgr_supportedcomponents=

# OS user and group that own the Ranger Admin installation.
unix_user=ranger
unix_user_pwd=ranger
unix_group=ranger

# Admin UI authentication: LDAP, ACTIVE_DIRECTORY, UNIX or NONE. The charm uses
# NONE (Ranger internal users), so the UNIX, LDAP, AD, Kerberos and SSO
# settings below are unused.
authentication_method=NONE
remoteLoginEnabled=true
authServiceHostName=localhost
authServicePort=5151
ranger_unixauth_keystore=keystore.jks
ranger_unixauth_keystore_password=password
ranger_unixauth_truststore=cacerts
ranger_unixauth_truststore_password=changeit

xa_ldap_url=
xa_ldap_userDNpattern=
xa_ldap_groupSearchBase=
xa_ldap_groupSearchFilter=
xa_ldap_groupRoleAttribute=
xa_ldap_base_dn=
xa_ldap_bind_dn=
xa_ldap_bind_password=
xa_ldap_referral=
xa_ldap_userSearchFilter=

xa_ldap_ad_domain=
xa_ldap_ad_url=
xa_ldap_ad_base_dn=
xa_ldap_ad_bind_dn=
xa_ldap_ad_bind_password=
xa_ldap_ad_referral=
xa_ldap_ad_userSearchFilter=

# Kerberos. token_valid must remain a number: the Kerberos authentication
# filter parses it even when Kerberos is disabled.
spnego_principal=
spnego_keytab=
token_valid=30
cookie_domain=
cookie_path=/
admin_principal=
admin_keytab=
lookup_principal=
lookup_keytab=
hadoop_conf=

# Knox SSO.
sso_enabled=false
sso_providerurl=https://127.0.0.1:8443/gateway/knoxsso/api/v1/websso
sso_publickey=

RANGER_ADMIN_LOG_DIR=$PWD
RANGER_PID_DIR_PATH=/var/run/ranger

# Installer internals; change only with a full understanding of setup.sh.
XAPOLICYMGR_DIR=$PWD
app_home=$PWD/ews/webapp
TMPFILE=$PWD/.fi_tmp
LOGFILE=$PWD/logfile
LOGFILES="$LOGFILE"

JAVA_BIN='java'
JAVA_VERSION_REQUIRED='1.8'
JAVA_ORACLE='Java(TM) SE Runtime Environment'

# Heap for setup's database patch utilities only; the Admin server heap is set
# by ews/ranger-admin-services.sh.
ranger_admin_max_heap_size=1g
# Seconds to wait before retrying database and Java patches.
PATCH_RETRY_INTERVAL=120
STALE_PATCH_ENTRY_HOLD_TIME=10

# Schema files for each supported database flavor.
mysql_core_file=db/mysql/optimized/current/ranger_core_db_mysql.sql
mysql_audit_file=db/mysql/xa_audit_db.sql
oracle_core_file=db/oracle/optimized/current/ranger_core_db_oracle.sql
oracle_audit_file=db/oracle/xa_audit_db_oracle.sql
postgres_core_file=db/postgres/optimized/current/ranger_core_db_postgres.sql
postgres_audit_file=db/postgres/xa_audit_db_postgres.sql
sqlserver_core_file=db/sqlserver/optimized/current/ranger_core_db_sqlserver.sql
sqlserver_audit_file=db/sqlserver/xa_audit_db_sqlserver.sql
sqlanywhere_core_file=db/sqlanywhere/optimized/current/ranger_core_db_sqlanywhere.sql
sqlanywhere_audit_file=db/sqlanywhere/xa_audit_db_sqlanywhere.sql
cred_keystore_filename=$app_home/WEB-INF/classes/conf/.jceks/rangeradmin.jceks
RANGER_ADMIN_LOGBACK_CONF_FILE=
